# Copy to .env and fill in real values for your environment.
# NEVER commit the real .env file (see spec section 51/52).

NODE_ENV=development
PORT=3000

# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://sothis:sothis_dev_password@localhost:5432/sothis_hr_erp"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-with-a-random-32+-char-secret"
JWT_REFRESH_SECRET="replace-with-a-different-random-32+-char-secret"
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
INVITATION_EXPIRES_IN_DAYS=7

FRONTEND_URL="http://localhost:5173"
API_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:5173"

# Leave empty in dev; set a real DSN to enable Sentry in production.
SENTRY_DSN=""

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
LOGIN_THROTTLE_LIMIT=10
